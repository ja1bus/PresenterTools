<Window x:Class="PresenterTools.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PresenterTools.UI.Controls"
        xmlns:l="clr-namespace:PresenterTools.Core.Localization;assembly=PresenterTools.Core"
        xmlns:m="clr-namespace:PresenterTools.Core.Models;assembly=PresenterTools.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{x:Static l:Strings.SettingsTitle}"
        Width="680" Height="640" MinWidth="560" MinHeight="420"
        FontFamily="Segoe UI, Meiryo UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <!-- 文字列は Core/Localization/Strings(.ja).resx（SPEC §34）。項目名の列は英語の長い表記に合わせて自動で広がる（最小は従来の幅）。 -->
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="64" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <!-- タブの下部に並べる 2 つのボタン（Tag に SettingsSection の名前） -->
        <Style x:Key="TabFooter" TargetType="StackPanel">
            <Setter Property="DockPanel.Dock" Value="Bottom" />
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,4,12,8" />
        </Style>
        <Style x:Key="RevertButton" TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Content" Value="{x:Static l:Strings.SetRevert}" />
            <Setter Property="ToolTip" Value="{x:Static l:Strings.SetRevertToolTip}" />
        </Style>
        <Style x:Key="ResetButton" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Content" Value="{x:Static l:Strings.SetReset}" />
            <Setter Property="ToolTip" Value="{x:Static l:Strings.SetResetToolTip}" />
        </Style>

        <!-- ショートカット 1 行（ラベル・入力欄・クリア・登録状態） -->
        <DataTemplate x:Key="HotkeyRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0" />
                <c:ShortcutBox Grid.Column="1" Shortcut="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" Height="26"
                               CaptureStarted="OnCaptureStarted" CaptureEnded="OnCaptureEnded" />
                <Button Grid.Column="2" Content="{x:Static l:Strings.SetClear}" Margin="4,0,0,0" Padding="8,0" Click="OnClearHotkey" Focusable="False" />
                <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,0,0"
                           TextWrapping="Wrap" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#555" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <!-- ショートカット入力中は全ショートカットを一時解除している（D-17）。どのタブからも見える位置に理由を出す -->
            <TextBlock DockPanel.Dock="Top" x:Name="SuspendNotice" TextWrapping="Wrap" FontSize="12" Foreground="#8A4B00"
                       Margin="0,0,0,6" Visibility="Collapsed" Text="{x:Static l:Strings.SetHotkeysSuspendedNotice}" />
            <TextBlock DockPanel.Dock="Top" x:Name="NoticeText" TextWrapping="Wrap" FontSize="12" Foreground="#1565C0" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static l:Strings.SetOk}" MinWidth="90" Height="28" Padding="8,0" IsDefault="True" Click="OnOk" />
                <Button Content="{x:Static l:Strings.SetApply}" MinWidth="90" Height="28" Padding="8,0" Margin="8,0,0,0" Click="OnApply" />
                <Button Content="{x:Static l:Strings.SetCancel}" MinWidth="90" Height="28" Padding="8,0" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                <!-- 取扱説明書は Web にだけ置く。表示言語に合わせた URL を既定のブラウザーで開く（SPEC §10.2）。 -->
                <TextBlock Margin="0,0,0,2">
                    <Hyperlink x:Name="ManualLink" Click="OnOpenManual">
                        <Run Text="{x:Static l:Strings.SetManualLink}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="#555" />
                <TextBlock Text="© ja1bus" FontSize="11" Foreground="#555" />
            </StackPanel>
        </DockPanel>

        <TabControl>
            <!-- General -->
            <TabItem Header="General">
                <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="12,4,12,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ResetButton}" Tag="General" Click="OnResetSection"
                            ToolTip="{x:Static l:Strings.SetGeneralResetToolTip}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource RevertButton}" Margin="8,0,0,0" Tag="General" Click="OnRevertSection"
                            ToolTip="{x:Static l:Strings.SetGeneralRevertToolTip}" />
                    <Button HorizontalAlignment="Left" Padding="10,3" Content="{x:Static l:Strings.SetResetAll}" Click="OnResetAll"
                            ToolTip="{x:Static l:Strings.SetResetAllToolTip}" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="{x:Static l:Strings.SetGroupOnOff}">
                            <WrapPanel>
                                <CheckBox Content="Master" IsChecked="{Binding Settings.General.MasterEnabled}" Width="150" FontWeight="Bold" />
                                <CheckBox Content="Cursor Highlight" IsChecked="{Binding Settings.CursorHighlight.Enabled}" Width="150" />
                                <CheckBox Content="Click Effect" IsChecked="{Binding Settings.ClickEffect.Enabled}" Width="150" />
                                <CheckBox Content="Laser" IsChecked="{Binding Settings.Laser.Enabled}" Width="150" />
                                <CheckBox Content="Magnifier" IsChecked="{Binding MagnifierEnabled}" Width="150" />
                            </WrapPanel>
                        </GroupBox>
                        <GroupBox Header="{x:Static l:Strings.SetGroupPanel}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding Settings.General.AlwaysOnTop}">
                                    <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SetAlwaysOnTop}" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding Settings.General.HideOwnShortcutsInKeyDisplay}">
                                    <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SetHideOwnShortcuts}" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding Settings.General.ShowShortcutsInPanel}">
                                    <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SetShowShortcutsInPanel}" />
                                </CheckBox>
                            </StackPanel>
                        </GroupBox>
                        <!-- 表示言語（V1.3.1。SPEC §34）。変更は再起動後に反映（［適用］／［OK］で保存したときに再起動を確認する）。
                             English・日本語は今の表示言語にかかわらずその言語自身で書く（読めない言語を選んでも戻せるように）。 -->
                        <GroupBox Header="{x:Static l:Strings.SetGroupLanguage}">
                            <StackPanel>
                                <ComboBox MinWidth="260" SelectedValuePath="Tag" SelectedValue="{Binding Settings.General.Language}">
                                    <ComboBoxItem Tag="" Content="{x:Static l:Strings.LanguageSystem}" />
                                    <ComboBoxItem Tag="en" Content="English" />
                                    <ComboBoxItem Tag="ja" Content="日本語" />
                                </ComboBox>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="12" Margin="0,4,0,0"
                                           Text="{x:Static l:Strings.SetLanguageNote}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{x:Static l:Strings.SetGroupHotkeys}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="12" Margin="0,0,0,6"
                                           Text="{x:Static l:Strings.SetHotkeysHelp}" />
                                <ItemsControl ItemsSource="{Binding Hotkeys.All}" ItemTemplate="{StaticResource HotkeyRow}" />
                                <Button HorizontalAlignment="Right" Margin="0,6,0,0" Padding="10,3" Content="{x:Static l:Strings.SetResetHotkeys}" Click="OnResetHotkeys"
                                        ToolTip="{x:Static l:Strings.SetResetHotkeysToolTip}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Cursor Highlight -->
            <TabItem Header="Cursor Highlight">
                <DockPanel>
                <StackPanel Style="{StaticResource TabFooter}">
                    <Button Style="{StaticResource RevertButton}" Tag="CursorHighlight" Click="OnRevertSection" />
                    <Button Style="{StaticResource ResetButton}" Tag="CursorHighlight" Click="OnResetSection" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.ColumnSpan="3" Content="{x:Static l:Strings.SetCursorEnable}" IsChecked="{Binding Settings.CursorHighlight.Enabled}" />
                        <TextBlock Grid.Row="1" Text="{x:Static l:Strings.SetShape}" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Settings.CursorHighlight.Style}">
                            <ComboBoxItem Tag="{x:Static m:CursorHighlightStyle.Ring}" Content="{x:Static l:Strings.SetShapeRing}" />
                            <ComboBoxItem Tag="{x:Static m:CursorHighlightStyle.FilledCircle}" Content="{x:Static l:Strings.SetShapeFilled}" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="{x:Static l:Strings.SetColor}" Style="{StaticResource Label}" />
                        <c:ColorField Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Color="{Binding Settings.CursorHighlight.Color}" />
                        <TextBlock Grid.Row="3" Text="{x:Static l:Strings.SetOpacity}" Style="{StaticResource Label}" ToolTip="{x:Static l:Strings.SetOpacityToolTip}" />
                        <Slider Grid.Row="3" Grid.Column="1" x:Name="RingOpacity" Minimum="0.1" Maximum="1" TickFrequency="0.05" Value="{Binding Settings.CursorHighlight.Opacity}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=RingOpacity, StringFormat={}{0:P0}}" />
                        <TextBlock Grid.Row="4" Text="{x:Static l:Strings.SetFillOpacity}" Style="{StaticResource Label}" ToolTip="{x:Static l:Strings.SetFillOpacityToolTip}" />
                        <Slider Grid.Row="4" Grid.Column="1" x:Name="RingFillOpacity" Minimum="0.05" Maximum="0.8" TickFrequency="0.05" Value="{Binding Settings.CursorHighlight.FillOpacity}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=RingFillOpacity, StringFormat={}{0:P0}}" />
                        <TextBlock Grid.Row="5" Text="{x:Static l:Strings.SetDiameter}" Style="{StaticResource Label}" ToolTip="{x:Static l:Strings.SetDiameterToolTip}" />
                        <Slider Grid.Row="5" Grid.Column="1" x:Name="RingSize" Minimum="20" Maximum="300" TickFrequency="2" Value="{Binding Settings.CursorHighlight.Diameter}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=RingSize}" />
                        <TextBlock Grid.Row="6" Text="{x:Static l:Strings.SetLineWidth}" Style="{StaticResource Label}" ToolTip="{x:Static l:Strings.SetRingWidthToolTip}" />
                        <Slider Grid.Row="6" Grid.Column="1" x:Name="RingThickness" Minimum="1" Maximum="30" TickFrequency="1" Value="{Binding Settings.CursorHighlight.Thickness}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=RingThickness}" />
                        <ContentControl Grid.Row="7" Grid.ColumnSpan="3" Margin="0,8,0,0" Content="{Binding Hotkeys.ToggleCursorHighlight}" ContentTemplate="{StaticResource HotkeyRow}" />
                        <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Style="{StaticResource Help}" Text="{x:Static l:Strings.SetCursorHelp}" />
                    </Grid>
                </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Click Effect -->
            <TabItem Header="Click Effect">
                <DockPanel>
                <StackPanel Style="{StaticResource TabFooter}">
                    <Button Style="{StaticResource RevertButton}" Tag="ClickEffect" Click="OnRevertSection" />
                    <Button Style="{StaticResource ResetButton}" Tag="ClickEffect" Click="OnResetSection" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.ColumnSpan="3" Content="{x:Static l:Strings.SetClickEnable}" IsChecked="{Binding Settings.ClickEffect.Enabled}" />
                        <TextBlock Grid.Row="1" Text="{x:Static l:Strings.SetLeftColor}" Style="{StaticResource Label}" />
                        <c:ColorField Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Color="{Binding Settings.ClickEffect.LeftColor}" />
                        <TextBlock Grid.Row="2" Text="{x:Static l:Strings.SetRightColor}" Style="{StaticResource Label}" />
                        <c:ColorField Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Color="{Binding Settings.ClickEffect.RightColor}" />
                        <TextBlock Grid.Row="3" Text="{x:Static l:Strings.SetSize}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="3" Grid.Column="1" x:Name="ClickSize" Minimum="20" Maximum="300" TickFrequency="2" Value="{Binding Settings.ClickEffect.Size}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=ClickSize}" />
                        <TextBlock Grid.Row="4" Text="{x:Static l:Strings.SetDurationMs}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="4" Grid.Column="1" x:Name="ClickDuration" Minimum="150" Maximum="1500" TickFrequency="50" Value="{Binding Settings.ClickEffect.DurationMs}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=ClickDuration}" />
                        <CheckBox Grid.Row="5" Grid.ColumnSpan="3" Margin="0,8,0,3" IsChecked="{Binding Settings.ClickEffect.ShowButtonLabel}">
                            <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SetShowButtonLabel}" />
                        </CheckBox>
                        <CheckBox Grid.Row="6" Grid.ColumnSpan="3" IsChecked="{Binding Settings.ClickEffect.ShowWhileHeld}">
                            <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SetShowWhileHeld}" />
                        </CheckBox>
                        <ContentControl Grid.Row="7" Grid.ColumnSpan="3" Margin="0,8,0,0" Content="{Binding Hotkeys.ToggleClickEffect}" ContentTemplate="{StaticResource HotkeyRow}" />
                        <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Style="{StaticResource Help}" Text="{x:Static l:Strings.SetClickHelp}" />
                    </Grid>
                </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Laser -->
            <TabItem Header="Laser">
                <DockPanel>
                <StackPanel Style="{StaticResource TabFooter}">
                    <Button Style="{StaticResource RevertButton}" Tag="Laser" Click="OnRevertSection" />
                    <Button Style="{StaticResource ResetButton}" Tag="Laser" Click="OnResetSection" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.ColumnSpan="3" IsChecked="{Binding Settings.Laser.Enabled}">
                            <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SetLaserEnable}" />
                        </CheckBox>
                        <TextBlock Grid.Row="1" Text="{x:Static l:Strings.SetColor}" Style="{StaticResource Label}" />
                        <c:ColorField Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Color="{Binding Settings.Laser.Color}" />
                        <TextBlock Grid.Row="2" Text="{x:Static l:Strings.SetLineWidth}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="LaserWidth" Minimum="2" Maximum="40" TickFrequency="1" Value="{Binding Settings.Laser.Width}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=LaserWidth}" />
                        <TextBlock Grid.Row="3" Text="{x:Static l:Strings.SetTrailSeconds}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="3" Grid.Column="1" x:Name="LaserTrail" Minimum="0.2" Maximum="3" TickFrequency="0.1" Value="{Binding Settings.Laser.TrailSeconds}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=LaserTrail, StringFormat={}{0:0.0}}" />
                        <TextBlock Grid.Row="4" Text="{x:Static l:Strings.SetTryDrawing}" Style="{StaticResource Label}" VerticalAlignment="Top" />
                        <c:LaserPreviewBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LaserPreview" Height="130" Margin="0,6" />
                        <TextBlock Grid.Row="5" Text="{x:Static l:Strings.SetTriggerMode}" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Settings.Laser.TriggerMode}">
                            <ComboBoxItem Tag="{x:Static m:LaserTriggerMode.Hold}" Content="{x:Static l:Strings.SetTriggerHold}" />
                            <ComboBoxItem Tag="{x:Static m:LaserTriggerMode.Toggle}" Content="{x:Static l:Strings.SetTriggerToggle}" />
                        </ComboBox>
                        <ContentControl Grid.Row="6" Grid.ColumnSpan="3" Margin="0,8,0,0" Content="{Binding Hotkeys.LaserHold}" ContentTemplate="{StaticResource HotkeyRow}" />
                        <ContentControl Grid.Row="7" Grid.ColumnSpan="3" Content="{Binding Hotkeys.ToggleLaser}" ContentTemplate="{StaticResource HotkeyRow}" />
                        <TextBlock Grid.Row="8" Text="{x:Static l:Strings.SetMouseButton}" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="8" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Settings.Laser.MouseButton}">
                            <ComboBoxItem Tag="{x:Static m:MouseTriggerButton.None}" Content="{x:Static l:Strings.SetMouseNone}" />
                            <ComboBoxItem Tag="{x:Static m:MouseTriggerButton.XButton1}" Content="{x:Static l:Strings.SetLaserX1}" />
                            <ComboBoxItem Tag="{x:Static m:MouseTriggerButton.XButton2}" Content="{x:Static l:Strings.SetLaserX2}" />
                        </ComboBox>
                        <TextBlock Grid.Row="9" Grid.ColumnSpan="3" Style="{StaticResource Help}" Text="{x:Static l:Strings.SetLaserHelp}" />
                    </Grid>
                </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Magnifier -->
            <TabItem Header="Magnifier">
                <DockPanel>
                <StackPanel Style="{StaticResource TabFooter}">
                    <Button Style="{StaticResource RevertButton}" Tag="Magnifier" Click="OnRevertSection" />
                    <Button Style="{StaticResource ResetButton}" Tag="Magnifier" Click="OnResetSection" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.ColumnSpan="3" Content="{x:Static l:Strings.SetMagEnable}" IsChecked="{Binding MagnifierEnabled}" />
                        <TextBlock Grid.Row="1" Text="{x:Static l:Strings.SetZoom}" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Settings.Magnifier.ZoomPercent}">
                            <ComboBoxItem Content="200%"><ComboBoxItem.Tag><sys:Int32>200</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="300%"><ComboBoxItem.Tag><sys:Int32>300</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="400%"><ComboBoxItem.Tag><sys:Int32>400</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="{x:Static l:Strings.SetMagWidth}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="MagWidth" Minimum="200" Maximum="1200" TickFrequency="20" Value="{Binding Settings.Magnifier.Width}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=MagWidth}" />
                        <TextBlock Grid.Row="3" Text="{x:Static l:Strings.SetMagHeight}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="3" Grid.Column="1" x:Name="MagHeight" Minimum="120" Maximum="800" TickFrequency="20" Value="{Binding Settings.Magnifier.Height}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=MagHeight}" />
                        <ContentControl Grid.Row="4" Grid.ColumnSpan="3" Margin="0,8,0,0" Content="{Binding Hotkeys.ToggleMagnifier}" ContentTemplate="{StaticResource HotkeyRow}" />
                        <TextBlock Grid.Row="5" Text="{x:Static l:Strings.SetMouseButton}" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Settings.Magnifier.MouseButton}">
                            <ComboBoxItem Tag="{x:Static m:MouseTriggerButton.None}" Content="{x:Static l:Strings.SetMouseNone}" />
                            <ComboBoxItem Tag="{x:Static m:MouseTriggerButton.XButton1}" Content="{x:Static l:Strings.SetMagX1}" />
                            <ComboBoxItem Tag="{x:Static m:MouseTriggerButton.XButton2}" Content="{x:Static l:Strings.SetMagX2}" />
                        </ComboBox>
                        <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Style="{StaticResource Help}" Text="{x:Static l:Strings.SetMagHelp}" />
                    </Grid>
                </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Key Display -->
            <TabItem Header="Key Display">
                <DockPanel>
                <StackPanel Style="{StaticResource TabFooter}">
                    <Button Style="{StaticResource RevertButton}" Tag="KeyDisplay" Click="OnRevertSection" />
                    <Button Style="{StaticResource ResetButton}" Tag="KeyDisplay" Click="OnResetSection" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.ColumnSpan="3" Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap" Foreground="#B71C1C" Text="{x:Static l:Strings.SetKeyWarning}" />
                        </Border>
                        <TextBlock Grid.Row="1" Text="{x:Static l:Strings.SetKeyCurrent}" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding KeyDisplayMode}">
                            <ComboBoxItem Tag="{x:Static m:KeyDisplayMode.Off}" Content="OFF" />
                            <ComboBoxItem Tag="{x:Static m:KeyDisplayMode.FullText}" Content="{x:Static l:Strings.SetKeyOn}" />
                        </ComboBox>
                        <TextBlock Grid.Row="3" Text="{x:Static l:Strings.SetFontSize}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="3" Grid.Column="1" x:Name="KeyFont" Minimum="16" Maximum="120" TickFrequency="2" Value="{Binding Settings.KeyDisplay.FontSize}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=KeyFont}" />
                        <TextBlock Grid.Row="4" Text="{x:Static l:Strings.SetPosition}" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="4" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Settings.KeyDisplay.Position}">
                            <ComboBoxItem Tag="{x:Static m:KeyDisplayPosition.BottomCenter}" Content="{x:Static l:Strings.SetPosBottomCenter}" />
                            <ComboBoxItem Tag="{x:Static m:KeyDisplayPosition.BottomLeft}" Content="{x:Static l:Strings.SetPosBottomLeft}" />
                            <ComboBoxItem Tag="{x:Static m:KeyDisplayPosition.BottomRight}" Content="{x:Static l:Strings.SetPosBottomRight}" />
                            <ComboBoxItem Tag="{x:Static m:KeyDisplayPosition.TopCenter}" Content="{x:Static l:Strings.SetPosTopCenter}" />
                            <ComboBoxItem Tag="{x:Static m:KeyDisplayPosition.TopLeft}" Content="{x:Static l:Strings.SetPosTopLeft}" />
                            <ComboBoxItem Tag="{x:Static m:KeyDisplayPosition.TopRight}" Content="{x:Static l:Strings.SetPosTopRight}" />
                        </ComboBox>
                        <TextBlock Grid.Row="5" Text="{x:Static l:Strings.SetTextColor}" Style="{StaticResource Label}" />
                        <c:ColorField Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Color="{Binding Settings.KeyDisplay.TextColor}" />
                        <TextBlock Grid.Row="6" Text="{x:Static l:Strings.SetBackColor}" Style="{StaticResource Label}" />
                        <c:ColorField Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Color="{Binding Settings.KeyDisplay.BackgroundColor}" />
                        <TextBlock Grid.Row="7" Text="{x:Static l:Strings.SetBackOpacity}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="7" Grid.Column="1" x:Name="KeyBgOpacity" Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding Settings.KeyDisplay.BackgroundOpacity}" />
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=KeyBgOpacity, StringFormat={}{0:P0}}" />
                        <TextBlock Grid.Row="8" Text="{x:Static l:Strings.SetChordSeconds}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="8" Grid.Column="1" x:Name="KeyChord" Minimum="0.5" Maximum="10" TickFrequency="0.5" Value="{Binding Settings.KeyDisplay.ChordSeconds}" />
                        <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=KeyChord, StringFormat={}{0:0.0}}" />
                        <TextBlock Grid.Row="9" Text="{x:Static l:Strings.SetTextSeconds}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="9" Grid.Column="1" x:Name="KeyText" Minimum="1" Maximum="30" TickFrequency="0.5" Value="{Binding Settings.KeyDisplay.TextSeconds}" />
                        <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=KeyText, StringFormat={}{0:0.0}}" />
                        <TextBlock Grid.Row="10" Text="{x:Static l:Strings.SetEnterSeconds}" Style="{StaticResource Label}" />
                        <Slider Grid.Row="10" Grid.Column="1" x:Name="KeyEnter" Minimum="0.3" Maximum="10" TickFrequency="0.1" Value="{Binding Settings.KeyDisplay.EnterHoldSeconds}" />
                        <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=KeyEnter, StringFormat={}{0:0.0}}" />
                        <ContentControl Grid.Row="11" Grid.ColumnSpan="3" Margin="0,8,0,0" Content="{Binding Hotkeys.ToggleKeyDisplay}" ContentTemplate="{StaticResource HotkeyRow}" />
                    </Grid>
                </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
