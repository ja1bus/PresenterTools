<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイの NotifyIcon だけに使う（.NET の WindowsDesktop 共有フレームワークに含まれ、NuGet 依存ではない）。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 低レベルフックのコールバックで構造体をポインタから直接読むため。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PresenterTools</RootNamespace>
    <AssemblyName>PresenterTools</AssemblyName>
    <Version>1.5.0</Version>
    <!-- 設定画面の表示に使う。Version の更新漏れを防ぐため直接書かず Version を参照する。 -->
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>© ja1bus</Copyright>
    <ApplicationIcon>Resources/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010: WinForms 向けの「DPI 設定は manifest でなく API で」という助言。WPF は manifest の PerMonitorV2 を使うため抑止する。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <!-- 配布は Framework-dependent。対象 PC の .NET 8 Desktop Runtime を使い、.NET は内包しない。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 表示言語は英語（既定）と日本語だけ（V1.3.0。SPEC §34）。日本語の文字列は ja\PresenterTools.Core.resources.dll。 -->
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>

    <!-- Core / Tests / tools（説明書の画面画像を作る manual-shots など）は別 csproj。既定の Compile 対象から除外する。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;Tests/**;tools/**</DefaultItemExcludes>
  </PropertyGroup>
  <!--
    Microsoft Store 用の MSIX（V1.3.2〜。SPEC §28.1）。installer/msix/build-msix.ps1 が -p:PresenterToolsMsix=true で publish する。
    Store から入れた PC に .NET 8 Desktop Runtime があるとは限らないため、MSIX の中身だけは .NET を内包する（Self-contained・複数ファイル）。
    直接配布（フォルダ一式・Inno Setup）は従来どおり Framework-dependent で、この設定の影響を受けない。
  -->
  <PropertyGroup Condition="'$(PresenterToolsMsix)' == 'true'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF と WinForms の同名型（Application・MessageBox など）の衝突を避けるため、WinForms 側の暗黙 using を外す。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <!--
    ライセンス表記（V1.4.0。SPEC §10.2・§28）。MIT License の全文と第三者のソフトウェアの表記を、配布物（フォルダ一式・Inno Setup のインストール先・MSIX）の
    exe と同じフォルダーへ入れる。scripts では public-repo/ にある原本、公開リポジトリではルートにある同名のファイルを使う（公開リポジトリのビルドが public-repo/ に依存しないように）。
  -->
  <ItemGroup Condition="Exists('public-repo/LICENSE')">
    <None Update="public-repo/LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="public-repo/THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('public-repo/LICENSE') And Exists('LICENSE')">
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Core/PresenterTools.Core.csproj" />
  </ItemGroup>
</Project>
